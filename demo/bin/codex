#!/usr/bin/env python3
"""Stand-in for `codex queue --thread <id> --message <text>`, the native
Codex delivery the bridge calls (src/codex_sessions.rs). It drops the text in
the thread's inbox folder, which the stand-in Codex agent reads."""
import os
import sys
import time
import uuid

args = sys.argv[1:]
if len(args) != 5 or args[0] != "queue" or args[1] != "--thread" or args[3] != "--message":
    sys.exit("usage: codex queue --thread <id> --message <text>")
thread, text = args[2], args[4]
home = os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))
inbox = os.path.join(home, "demo-inbox", thread)
if not os.path.isdir(inbox):
    sys.exit(f"no live thread {thread}")
name = f"{time.time_ns()}-{uuid.uuid4()}"
with open(os.path.join(inbox, name + ".tmp"), "w") as f:
    f.write(text)
os.rename(os.path.join(inbox, name + ".tmp"), os.path.join(inbox, name + ".txt"))
