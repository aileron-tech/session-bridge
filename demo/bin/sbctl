#!/usr/bin/env python3
"""Send one control request (a JSON object) to this laptop's bridge and print
the reply. Example: sbctl '{"method": "lan"}'"""
import json
import os
import socket
import sys

SOCKET = os.path.join(os.environ.get("SESSION_BRIDGE_STATE") or os.path.expanduser("~/.local/state/session-bridge"), "control.sock")


def call(request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(30)
        conn.connect(SOCKET)
        conn.sendall(json.dumps(request).encode() + b"\n")
        data = b""
        while not data.endswith(b"\n"):
            chunk = conn.recv(65536)
            if not chunk:
                break
            data += chunk
    return json.loads(data)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    print(json.dumps(call(json.loads(sys.argv[1])), indent=2))
